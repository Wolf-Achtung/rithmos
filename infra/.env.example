# Copy to infra/.env for local docker-compose. Never commit real values.

# PostgreSQL (docker-compose service "db")
POSTGRES_DB=rithmos
POSTGRES_USER=rithmos
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# API (docker-compose service "api"; on Railway set these as service variables)
DATABASE_URL=postgresql://rithmos:change-me@localhost:5432/rithmos
# Shared secret between jobs/ and POST /v1/admin/puzzles. Generate with: openssl rand -base64 32
RITHMOS_JOBS_TOKEN=change-me
# Comma-separated browser origins allowed to call the API (the Netlify web build), empty = none
RITHMOS_CORS_ORIGINS=
API_PORT=8000

# jobs/ (nightly Middles generator; on Railway set on the cron service)
RITHMOS_API_URL=http://localhost:8000
# RITHMOS_JOBS_TOKEN as above

# app/ (Expo; EXPO_PUBLIC_ variables are compiled into the bundle, never put secrets here)
EXPO_PUBLIC_API_URL=http://localhost:8000
